seo:frame_HostileExclamation a seo:EmotionFrame ;
    rdfs:label "HostileExclamation" ;
    seo:hasAgentEmotion seo:Angry ;
    seo:hasNegatedEmotion seo:Neutral ;
    seo:hasPatientEmotion seo:Angry ;
    seo:hasPolarity "negative"^^xsd:string ;
    seo:hasTypicalEmotion seo:Angry ;
    seo:hasWeight "0.9"^^xsd:float ;
    rdfs:comment "Hostile expletives and aggressive exclamations used in anger" .

seo:frame_Destruction a seo:EmotionFrame ;
    rdfs:label "Destruction" ;
    seo:hasAgentEmotion seo:Angry ;
    seo:hasNegatedEmotion seo:Neutral ;
