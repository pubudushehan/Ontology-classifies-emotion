    seo:hasPolarity "negative"^^xsd:string ;
    seo:hasTypicalEmotion seo:Angry ;
    seo:hasWeight "1.0"^^xsd:float ;
    rdfs:comment "Destroying, breaking, or damaging objects or property" .

